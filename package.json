{
  "name": "exchange-map",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "collect": "tsx --env-file-if-exists=.env.local collector/index.ts",
    "probe": "tsx collector/probe.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "geocode": "tsx --env-file-if-exists=.env.local collector/geocode.ts",
    "build-places": "tsx --env-file-if-exists=.env.local collector/build-places.ts",
    "build-by-words": "tsx collector/build-by-words.ts",
    "check-health": "tsx --env-file-if-exists=.env.local collector/check-health.ts",
    "recheck-by": "tsx --env-file-if-exists=.env.local collector/recheck-by.ts",
    "check-coords": "tsx --env-file-if-exists=.env.local collector/check-coords.ts",
    "stats": "tsx --env-file-if-exists=.env.local collector/stats.ts",
    "try-parse": "tsx collector/try-parse.ts",
    "dupes": "tsx --env-file-if-exists=.env.local collector/dupes.ts",
    "sanitize-db": "tsx --env-file-if-exists=.env.local collector/sanitize-db.ts",
    "myfin-details": "tsx --env-file-if-exists=.env.local collector/myfin-details.ts",
    "build-cities": "tsx collector/build-cities.ts",
    "weekly": "tsx --env-file-if-exists=.env.local collector/weekly.ts"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^26.6.4",
    "dotenv": "^18.0.6",
    "drizzle-kit": "^0.31.11",
    "osm-pbf-parser-node": "^1.1.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@tomickigrzegorz/leaflet-rotate": "^0.3.0",
    "@vercel/functions": "^3.9.11",
    "drizzle-orm": "^0.45.4",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3"
  }
}
