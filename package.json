{
  "name": "exchange-map",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "collect": "tsx --env-file-if-exists=.env.local collector/index.ts",
    "probe": "tsx collector/probe.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "geocode": "tsx --env-file-if-exists=.env.local collector/geocode.ts",
    "stats": "tsx --env-file-if-exists=.env.local collector/stats.ts"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.4",
    "dotenv": "^18.0.6",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/functions": "^3.9.11",
    "drizzle-orm": "^0.45.4",
    "leaflet": "^1.9.4"
  }
}
